{
    "name": "nexwolf-workspace",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "start": "npm run start --workspace=client",
        "start:client": "npm run start --workspace=client",
        "start:company": "npm run start --workspace=company",
        "test:auth": "node --test scripts/test-auth-login.mjs scripts/test-company-auth.mjs"
    },
    "devDependencies": {
        "turbo": "^2.11.7"
    },
    "packageManager": "npm@11.6.3"
}
